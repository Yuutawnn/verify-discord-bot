# Token của bot Discord (Lấy từ Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Application ID của bot (Lấy từ Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# (Tùy chọn) ID Server Discord của bạn để đăng ký lệnh Slash cập nhật ngay lập tức
GUILD_ID=your_guild_id_here
